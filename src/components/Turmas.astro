---
import { turmas } from "../data/site";
---

<section class="turmas" id="turmas" aria-labelledby="turmas-titulo">
  <div class="wrap turmas__grid">
    <div class="turmas__lado">
      <h2 id="turmas-titulo" class="titulo h2">Em que série você vai estudar em 2027?</h2>
      <p class="turmas__nota">O Córtex tem as três séries do Ensino Médio e o Extensivo, de pré-vestibular, no mesmo endereço da Rua T-53.</p>

      <fieldset class="serie" aria-describedby="serie-dica">
        <legend class="serie__rotulo">Escolha a série</legend>
        <div class="serie__opcoes">
          {
            turmas.map((t, i) => (
              <label class="serie__opcao">
                <input type="radio" name="serie-turmas" value={t.id} checked={i === 0} data-serie />
                <span class="serie__bolha" aria-hidden="true" />
                <span class="serie__nome">{t.nome}</span>
              </label>
            ))
          }
        </div>
        <p class="serie__dica" id="serie-dica">Marque uma série para ver a turma.</p>
      </fieldset>
    </div>

    <ol class="turmas__lista" role="list">
      {
        turmas.map((t, i) => (
          <li class:list={["turma", { ativa: i === 0 }]} data-turma={t.id}>
            <div class="turma__topo">
              <h3 class="turma__nome">{t.nome}</h3>
              <span class="turma__etapa">{t.etapa}</span>
            </div>
            <p class="turma__para">{t.para}</p>
            <p class="turma__texto">{t.texto}</p>
            <p class="turma__bolsa">
              {t.provaDeBolsas ? "Vale a Prova de Bolsas, com até 100% de desconto." : "A Prova de Bolsas não vale para o Extensivo."}
            </p>
            <a class="link turma__acao" href="#visita" data-escolher={t.id} data-interesse="visita">
              Agendar visita para a {t.nome}
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Marcar a série acende o cartão da turma. O link do cartão leva a escolha até o formulário da Prova de Bolsas.
  const opcoes = [...document.querySelectorAll<HTMLInputElement>("[data-serie]")];
  const cartoes = [...document.querySelectorAll<HTMLElement>("[data-turma]")];
  const mostrar = (id: string) => cartoes.forEach((c) => c.classList.toggle("ativa", c.dataset.turma === id));
  opcoes.forEach((o) => o.addEventListener("change", () => mostrar(o.value)));
  cartoes.forEach((c) =>
    c.addEventListener("pointerenter", () => {
      const o = opcoes.find((x) => x.value === c.dataset.turma);
      if (o) {
        o.checked = true;
        mostrar(o.value);
      }
    }),
  );
  document.querySelectorAll<HTMLAnchorElement>("[data-escolher]").forEach((a) =>
    a.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("escolher-serie", { detail: { serie: a.dataset.escolher, interesse: a.dataset.interesse } }));
    }),
  );
</script>

<style>
  .turmas {
    padding-block: clamp(3.5rem, 2rem + 6vw, 7rem);
  }

  .turmas__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 2.5rem var(--gutter);
  }

  .turmas__lado {
    grid-column: 1 / span 5;
    align-self: start;
    position: sticky;
    top: calc(var(--header-h) + 2rem);
  }

  .turmas__nota {
    margin-top: 1.25rem;
    color: var(--tinta-2);
    max-width: 28em;
  }

  /* a escolha da série imita uma linha de gabarito: bolhas que recebem o X da marca */
  .serie {
    margin: 2rem 0 0;
    padding: 1.25rem;
    border: 1px solid var(--filete);
    border-radius: var(--r-2);
    background: var(--nevoa);
  }

  .serie__rotulo {
    float: left;
    width: 100%;
    font-size: var(--t-14);
    font-weight: 650;
    color: var(--tinta-2);
  }

  .serie__opcoes {
    clear: both;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    padding-top: 0.75rem;
  }

  .serie__opcao {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 0.75rem 0.25rem;
    min-height: 44px;
    border-radius: var(--r-1);
    cursor: pointer;
  }

  .serie__opcao input {
    position: absolute;
    inset: 0;
    opacity: 0;
    cursor: pointer;
  }

  .serie__bolha {
    position: relative;
    width: 34px;
    height: 34px;
    border: 2px solid var(--marinho);
    border-radius: 50%;
    background: var(--branco);
    transition: background-color 160ms var(--ease);
  }

  .serie__bolha::before,
  .serie__bolha::after {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 4px;
    height: 22px;
    margin: -11px 0 0 -2px;
    border-radius: 2px;
    background: var(--branco);
    transform: rotate(35deg) scale(0);
    transition: transform 200ms var(--ease);
  }

  .serie__bolha::after {
    transform: rotate(-35deg) scale(0);
  }

  .serie__opcao input:checked + .serie__bolha {
    background: var(--marinho);
  }

  .serie__opcao input:checked + .serie__bolha::before {
    transform: rotate(35deg) scale(1);
  }

  .serie__opcao input:checked + .serie__bolha::after {
    transform: rotate(-35deg) scale(1);
  }

  .serie__opcao input:focus-visible + .serie__bolha {
    outline: 2px solid var(--agua-700);
    outline-offset: 3px;
  }

  .serie__nome {
    font-size: var(--t-14);
    font-weight: 650;
    text-align: center;
  }

  .serie__dica {
    margin-top: 0.5rem;
    font-size: var(--t-12);
    color: var(--tinta-2);
  }

  .turmas__lista {
    grid-column: 7 / span 6;
    border-top: 1px solid var(--tinta);
  }

  .turma {
    position: relative;
    display: grid;
    gap: 0.35rem;
    padding: 1.5rem 0.75rem 1.5rem 1.25rem;
    border-bottom: 1px solid var(--filete);
    transition: background-color 160ms var(--ease);
  }

  .turma::before {
    content: "";
    position: absolute;
    left: 0;
    top: 1.5rem;
    bottom: 1.5rem;
    width: 4px;
    border-radius: 2px;
    background: transparent;
    transition: background-color 160ms var(--ease);
  }

  .turma.ativa {
    background: var(--nevoa);
  }

  .turma.ativa::before {
    background: var(--agua);
  }

  .turma__topo {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .turma__nome {
    font-size: var(--t-24);
    font-weight: 800;
    color: var(--marinho);
  }

  .turma__etapa {
    font-size: var(--t-14);
    color: var(--tinta-2);
  }

  .turma__para {
    font-weight: 650;
  }

  .turma__texto {
    color: var(--tinta-2);
    max-width: 36em;
  }

  .turma__bolsa {
    font-size: var(--t-14);
    font-weight: 600;
    color: var(--agua-700);
  }

  .turma__acao {
    justify-self: start;
    margin-top: 0.25rem;
    color: var(--marinho);
  }

  @media (max-width: 959px) {
    .turmas__lado,
    .turmas__lista {
      grid-column: 1 / -1;
      position: static;
    }
    /* no celular, só a turma escolhida mostra o texto completo */
    .turma:not(.ativa) .turma__texto,
    .turma:not(.ativa) .turma__bolsa,
    .turma:not(.ativa) .turma__acao {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .serie__opcoes {
      gap: 0.25rem;
    }
    .serie__nome {
      font-size: var(--t-12);
    }
  }
</style>
