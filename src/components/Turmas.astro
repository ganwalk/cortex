---
import { turmas } from "../data/site";
---

<section class="turmas" id="turmas" aria-labelledby="turmas-titulo">
  <div class="wrap">
    <div class="turmas__cabeca">
      <h2 id="turmas-titulo" class="titulo h2">Turmas em 2027</h2>
      <p class="lead">As três séries do Ensino Médio e o Extensivo, de pré-vestibular, no mesmo endereço da Rua T-53.</p>
    </div>

    <ol class="turmas__lista" role="list">
      {
        turmas.map((t, i) => (
          <li class="turma">
            <p class="turma__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="turma__nome">{t.nome}</h3>
            <p class="turma__etapa">{t.etapa}</p>
            <p class="turma__para">{t.para}</p>
            <p class="turma__texto">{t.texto}</p>
            <p class="turma__bolsa">{t.provaDeBolsas ? "Vale a Prova de Bolsas" : "Sem Prova de Bolsas"}</p>
            <a class="turma__acao" href="#visita" data-escolher={t.id} data-interesse="visita">
              Agendar visita <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // O link de cada turma leva a série escolhida até o formulário de visita.
  document.querySelectorAll<HTMLAnchorElement>("[data-escolher]").forEach((a) =>
    a.addEventListener("click", () => {
      document.dispatchEvent(new CustomEvent("escolher-serie", { detail: { serie: a.dataset.escolher, interesse: a.dataset.interesse } }));
    }),
  );
</script>

<style>
  .turmas {
    padding-block: clamp(4rem, 2rem + 6vw, 7rem);
    border-top: 1px solid var(--filete);
  }

  .turmas__cabeca .lead {
    margin-top: 1rem;
  }

  .turmas__lista {
    margin-top: 3rem;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--marinho);
  }

  .turma {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.5rem 1.5rem 1.75rem 0;
  }

  .turma + .turma {
    padding-left: 1.5rem;
    border-left: 1px solid var(--filete);
  }

  .turma__n {
    font-size: var(--t-12);
    font-variant-numeric: tabular-nums;
    color: var(--agua-700);
  }

  .turma__nome {
    margin-top: 0.75rem;
    font-size: var(--t-24);
    font-weight: 650;
    color: var(--marinho);
  }

  .turma__etapa {
    font-size: var(--t-14);
    color: var(--tinta-2);
  }

  .turma__para {
    margin-top: 0.75rem;
    font-weight: 600;
    font-size: var(--t-14);
  }

  .turma__texto {
    font-size: var(--t-14);
    color: var(--tinta-2);
  }

  .turma__bolsa {
    margin-top: auto;
    padding-top: 1rem;
    font-size: var(--t-12);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--agua-700);
  }

  .turma__acao {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 44px;
    font-size: var(--t-14);
    font-weight: 600;
    color: var(--marinho);
    text-decoration: none;
  }

  .turma__acao:hover {
    color: var(--agua-700);
  }

  @media (max-width: 959px) {
    .turmas__lista {
      grid-template-columns: 1fr 1fr;
    }
    .turma:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .turma:nth-child(n + 3) {
      border-top: 1px solid var(--filete);
    }
  }

  @media (max-width: 560px) {
    .turmas__lista {
      grid-template-columns: 1fr;
    }
    .turma + .turma {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--filete);
    }
  }
</style>
